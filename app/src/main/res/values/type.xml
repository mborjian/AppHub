<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Text" parent="android:Widget.TextView" />

    <style name="Text.Display">
        <item name="android:textSize">34sp</item>
        <item name="android:lineHeight">40dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Text.TitleXL">
        <item name="android:textSize">28sp</item>
        <item name="android:lineHeight">34dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Text.TitleL">
        <item name="android:textSize">21sp</item>
        <item name="android:lineHeight">26dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Text.TitleM">
        <item name="android:textSize">17sp</item>
        <item name="android:lineHeight">22dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Text.Body">
        <item name="android:textSize">15sp</item>
        <item name="android:lineHeight">21dp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Text.BodyStrong">
        <item name="android:textSize">15sp</item>
        <item name="android:lineHeight">21dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Text.BodyS">
        <item name="android:textSize">14sp</item>
        <item name="android:lineHeight">19dp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Text.Meta">
        <item name="android:textSize">13sp</item>
        <item name="android:lineHeight">17dp</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:textDirection">ltr</item>
    </style>

    <style name="Text.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:lineHeight">16dp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Text.Section">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Text.Field">
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Text.Number">
        <item name="android:textSize">21sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:textDirection">ltr</item>
    </style>

    <style name="Text.OnFill">
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/hub_on_fill</item>
    </style>

</resources>
