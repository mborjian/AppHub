<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="@dimen/touch_min"
    android:orientation="horizontal"
    android:paddingStart="@dimen/space_2"
    android:paddingTop="@dimen/space_2"
    android:paddingEnd="@dimen/space_5"
    android:paddingBottom="@dimen/space_2">

    <ImageView
        android:id="@+id/backButton"
        android:layout_width="@dimen/touch_min"
        android:layout_height="@dimen/touch_min"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:contentDescription="@string/settings_back"
        android:focusable="true"
        android:padding="@dimen/space_4"
        android:src="@drawable/ic_back"
        android:tint="@color/text_primary" />

    <TextView
        android:id="@+id/headerTitle"
        style="@style/Text.TitleL"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_1"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        tools:text="Settings" />

    <TextView
        android:id="@+id/headerTrailing"
        style="@style/Text.Meta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_3"
        android:ellipsize="end"
        android:maxLines="1"
        android:visibility="gone"
        tools:text="All 19 apps"
        tools:visibility="visible" />

</LinearLayout>
