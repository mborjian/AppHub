<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/space_1"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_5"
    android:paddingTop="@dimen/space_7"
    android:paddingEnd="@dimen/space_5"
    android:paddingBottom="@dimen/space_7">

    <ImageView
        android:id="@+id/panelIcon"
        android:layout_width="@dimen/icon_empty"
        android:layout_height="@dimen/icon_empty"
        android:contentDescription="@null"
        android:tint="@color/hub_ink_400"
        android:visibility="gone"
        tools:src="@drawable/ic_warning"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/panelNumeral"
        style="@style/Text.Display"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_3"
        android:visibility="gone"
        tools:text="0 apps"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/panelTitle"
        style="@style/Text.TitleM"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_3"
        android:gravity="center"
        tools:text="No apps yet" />

    <TextView
        android:id="@+id/panelMessage"
        style="@style/Text.BodyS"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2"
        android:gravity="center"
        tools:text="Apps you install on this unit appear here." />

    <TextView
        android:id="@+id/panelAction"
        style="@style/Text.OnFill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_5"
        android:background="@drawable/bg_pill"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:minHeight="@dimen/touch_min"
        android:minWidth="@dimen/touch_car"
        android:paddingStart="@dimen/space_6"
        android:paddingEnd="@dimen/space_6"
        android:text="@string/open_settings"
        android:visibility="gone"
        tools:visibility="visible" />

</LinearLayout>
