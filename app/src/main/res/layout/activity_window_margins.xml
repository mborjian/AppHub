<?xml version="1.0" encoding="utf-8"?>
<!-- The app window margins screen: the switch for the whole feature, one
     sentence about what the unit actually did, and the app list underneath.

     The sentence used to be 12sp at the bottom of a card, which is the wrong
     weight for the most interesting thing this app ever says - that it asked the
     window manager for something and was refused. It is a banner now, with the
     tone in its icon and its wash, and the app list gets the rest of the
     screen. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hub_page"
    android:orientation="vertical">

    <include
        layout="@layout/view_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- the master switch row is built in code, like every other row of a
         settings screen in this app -->
    <LinearLayout
        android:id="@+id/windowRows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_4"
        android:paddingEnd="@dimen/space_4" />

    <LinearLayout
        android:id="@+id/statusBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_4"
        android:layout_marginTop="@dimen/space_2"
        android:layout_marginEnd="@dimen/space_4"
        android:layout_marginBottom="@dimen/space_3"
        android:background="@drawable/bg_banner"
        android:gravity="center_vertical"
        android:minHeight="@dimen/banner_min_height"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_4"
        android:paddingTop="@dimen/space_3"
        android:paddingEnd="@dimen/space_4"
        android:paddingBottom="@dimen/space_3">

        <ImageView
            android:id="@+id/statusIcon"
            android:layout_width="@dimen/icon_row"
            android:layout_height="@dimen/icon_row"
            android:contentDescription="@null"
            android:src="@drawable/ic_frame"
            android:tint="@color/hub_blocked" />

        <TextView
            android:id="@+id/windowStatus"
            style="@style/Text.BodyS"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_3"
            android:layout_weight="1"
            tools:text="Charger opens fullscreen, and this unit only resizes freeform or multi-window tasks — nothing was moved." />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/space_4"
        android:layout_marginEnd="@dimen/space_4"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/windowList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/space_4"
            android:scrollbars="vertical" />

        <LinearLayout
            android:id="@+id/windowEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="@dimen/space_6"
            android:visibility="gone">

            <TextView
                android:id="@+id/windowEmptyTitle"
                style="@style/Text.BodyStrong"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/window_empty" />

            <TextView
                style="@style/Text.BodyS"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:gravity="center"
                android:text="@string/window_empty_hint" />
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
