<?xml version="1.0" encoding="utf-8"?>
<!-- The task manager: every open app, each with its own Close button.

     One column, not panes - this screen has exactly one job, and the header's
     count says how many apps are in front of the driver. The empty state has
     two titles' worth of answers on purpose: "nothing is open" and "nothing
     can be seen" are different things, and only one of them is a settings
     problem. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hub_page"
    android:orientation="vertical">

    <include
        layout="@layout/view_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- The one thing this screen has to admit to: with nothing but the usage
         view, "open" is not what the list is showing. It sits under the header
         and above the rows, and it is only there while the install cannot read
         the task list - on the unit it never appears. -->
    <include
        android:id="@+id/tasksBanner"
        layout="@layout/row_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        tools:visibility="visible" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="@dimen/space_4"
        android:paddingEnd="@dimen/space_4"
        android:paddingBottom="@dimen/space_4">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/taskList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/space_3"
            android:scrollbars="vertical" />

        <!-- what the screen says when the list is empty: two lines, because
             an answer is not a failure -->
        <LinearLayout
            android:id="@+id/listEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="@dimen/space_6"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/listEmptyTitle"
                style="@style/Text.BodyStrong"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/task_empty_title" />

            <TextView
                android:id="@+id/listEmptyMessage"
                style="@style/Text.BodyS"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:gravity="center"
                android:text="@string/task_empty_message" />
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
