<?xml version="1.0" encoding="utf-8"?>
<!-- The shortcuts screen: which apps the board shows on the left, and the board
     itself on the right.

     Two panes rather than a list with a preview above it, because the two halves
     are used together - tick an app, watch it arrive; move a tile, watch the
     order change - and a head unit screen is wide and short, which is the shape
     a pair of panes wants.

     All/None stay two buttons rather than becoming one segmented control: with
     eighteen of nineteen apps ticked the page is neither "all" nor "none", and a
     segmented control with nothing selected reads as broken. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hub_page"
    android:orientation="vertical">

    <include
        layout="@layout/view_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_4"
        android:paddingEnd="@dimen/space_4"
        android:paddingBottom="@dimen/space_4">

        <!-- the list on the left -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <include
                layout="@layout/row_filter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- One tap for the whole page: fill it or clear it. Quiet pills on
                 purpose - they are the pair of buttons a driver reaches for
                 without looking, so they are wide, tall and calm. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/selectAll"
                    style="@style/Text.BodyStrong"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/touch_min"
                    android:layout_marginEnd="@dimen/space_1"
                    android:layout_weight="1"
                    android:background="@drawable/bg_pill_quiet"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/select_all"
                    android:textColor="@color/primary_text" />

                <TextView
                    android:id="@+id/selectNone"
                    style="@style/Text.BodyStrong"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/touch_min"
                    android:layout_marginStart="@dimen/space_1"
                    android:layout_weight="1"
                    android:background="@drawable/bg_pill_quiet"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/select_none"
                    android:textColor="@color/primary_text" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/space_3"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/appList"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingBottom="@dimen/space_3"
                    android:scrollbars="vertical" />

                <!-- what a filtered list says when nothing matches: two lines,
                     because an answer is not a failure -->
                <LinearLayout
                    android:id="@+id/listEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="@dimen/space_6"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/listEmptyTitle"
                        style="@style/Text.BodyStrong"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/filter_none" />

                    <TextView
                        style="@style/Text.BodyS"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_1"
                        android:gravity="center"
                        android:text="@string/no_match_message" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <!-- the page on the right -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/space_4"
            android:layout_weight="1"
            android:background="@drawable/bg_setting_row"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_3"
            android:paddingTop="@dimen/space_3"
            android:paddingEnd="@dimen/space_3"
            android:paddingBottom="@dimen/space_3">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Text.TitleM"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/preview_title" />

                <TextView
                    style="@style/Text.Meta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_2"
                    android:text="@string/drag_hint" />
            </LinearLayout>

            <!-- the page itself: its icons, its shape, its names, its order -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/previewGrid"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/space_2"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingBottom="@dimen/space_3"
                android:scrollbars="vertical" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
