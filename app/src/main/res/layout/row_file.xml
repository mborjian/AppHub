<?xml version="1.0" encoding="utf-8"?>
<!-- One row of the file manager: what it is, what it is called, and - for the
     things that are not folders - its size and its date.

     The glyph is drawn at 24dp inside a 40dp box, by padding: an outline at
     1.75dp that has been stretched to a 40dp box would be a heavier mark than
     the same glyph anywhere else in the app, and the file manager's rows are
     the one place where five of them are read in a column.

     The button on the right is a real 56dp target, and it is the way into a
     row's verbs: a hold is not a thing to expect of a driver, and every row
     here has something that can be done to it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_1"
    android:background="@drawable/bg_setting_row"
    android:gravity="center_vertical"
    android:minHeight="@dimen/row_min_height"
    android:orientation="horizontal"
    android:paddingStart="@dimen/space_3"
    android:paddingTop="@dimen/space_2"
    android:paddingEnd="@dimen/space_3"
    android:paddingBottom="@dimen/space_2">

    <ImageView
        android:id="@+id/rowIcon"
        android:layout_width="@dimen/icon_app_row"
        android:layout_height="@dimen/icon_app_row"
        android:contentDescription="@null"
        android:padding="@dimen/space_2"
        android:tint="@color/hub_ink_600"
        tools:src="@drawable/ic_folder" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_3"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/rowLabel"
            style="@style/Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:maxLines="1"
            tools:text="Dashcam" />

        <!-- gone for a folder: what is inside it is not read until it is opened,
             and a row that says "Folder" under a folder glyph says it twice -->
        <TextView
            android:id="@+id/rowMeta"
            style="@style/Text.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="middle"
            android:maxLines="1"
            tools:text="8.4 MB · 12 Sep 2026" />
    </LinearLayout>

    <ImageView
        android:id="@+id/rowMore"
        android:layout_width="@dimen/touch_min"
        android:layout_height="@dimen/touch_min"
        android:layout_marginStart="@dimen/space_2"
        android:background="@drawable/bg_icon_button"
        android:clickable="true"
        android:contentDescription="@string/more_actions"
        android:focusable="true"
        android:padding="@dimen/badge_glyph_inset"
        android:src="@drawable/ic_more"
        android:tint="@color/primary_text"
        tools:visibility="visible" />

</LinearLayout>
