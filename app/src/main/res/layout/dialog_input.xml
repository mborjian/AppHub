<?xml version="1.0" encoding="utf-8"?>
<!-- The typed half of a number sheet: one numeric field with its unit.

     Same rounded box as a row, so the field does not look like a foreign widget
     inside the card. The keyboard opens on show and the field is selected, so a
     known number can be replaced without clearing it by hand. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/space_4"
    android:paddingTop="@dimen/space_2"
    android:paddingEnd="@dimen/space_4"
    android:paddingBottom="@dimen/space_4">

    <EditText
        android:id="@+id/inputValue"
        style="@style/Text.Number"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="@drawable/bg_setting_row"
        android:imeOptions="actionDone"
        android:importantForAutofill="no"
        android:inputType="number"
        android:maxLines="1"
        android:minHeight="@dimen/touch_min"
        android:paddingStart="@dimen/space_4"
        android:paddingTop="@dimen/space_2"
        android:paddingEnd="@dimen/space_4"
        android:paddingBottom="@dimen/space_2"
        android:selectAllOnFocus="true"
        android:textCursorDrawable="@null"
        tools:text="96" />

    <TextView
        android:id="@+id/inputUnit"
        style="@style/Text.Body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_3"
        tools:text="dp" />

</LinearLayout>
