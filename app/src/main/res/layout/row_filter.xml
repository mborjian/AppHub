<?xml version="1.0" encoding="utf-8"?>
<!-- The filter of the shortcuts list: a plain field, so the apps below it can be
     narrowed by typing. It stays above the list rather than scrolling with it,
     since it is what makes the rest of the list reachable.

     Styled like a row rather than like a text box, so it does not look like a
     foreign widget on a screen built from rows. The field is not focused when
     the screen opens: on a head unit the keyboard would cover the very list
     being filtered, and the remembered filter is already applied by then. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/space_2"
    android:background="@drawable/bg_setting_row"
    android:gravity="center_vertical"
    android:minHeight="@dimen/touch_min"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/filterIcon"
        android:layout_width="@dimen/icon_row"
        android:layout_height="@dimen/icon_row"
        android:layout_marginStart="@dimen/space_4"
        android:contentDescription="@null"
        android:src="@drawable/ic_search"
        android:tint="@color/hub_ink_600" />

    <EditText
        android:id="@+id/filterField"
        style="@style/Text.Field"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="@null"
        android:imeOptions="actionSearch|flagNoFullscreen"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="1"
        android:paddingStart="@dimen/space_3"
        android:paddingTop="@dimen/space_3"
        android:paddingEnd="@dimen/space_3"
        android:paddingBottom="@dimen/space_3"
        android:textColorHint="@color/hub_ink_400"
        android:textCursorDrawable="@null"
        tools:hint="Filter apps" />

    <!-- Only there once something has been typed, and wide enough to hit with a
         thumb: the glyph is 24dp but the target is 56dp. -->
    <ImageView
        android:id="@+id/filterClear"
        android:layout_width="@dimen/touch_min"
        android:layout_height="@dimen/touch_min"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:contentDescription="@string/filter_clear"
        android:focusable="true"
        android:padding="@dimen/space_4"
        android:src="@drawable/ic_close"
        android:tint="@color/hub_ink_600"
        android:visibility="gone"
        tools:visibility="visible" />

</LinearLayout>
