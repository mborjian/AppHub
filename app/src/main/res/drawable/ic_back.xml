<?xml version="1.0" encoding="utf-8"?>
<!-- Instrument glyphs: 24dp box, 1.75dp stroke, round caps and joins. Outline
     rather than filled, because a 24dp filled blob beside 15sp text reads
     heavier than the text it labels. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#00000000"
        android:pathData="M15,5.5 L8.5,12 L15,18.5"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="1.75" />
</vector>
