<?xml version="1.0" encoding="utf-8"?>
<!-- The file manager as a tile.

     Every other tile on the board is an app's own launcher icon, filled edge to
     edge, which the icon-shape setting then clips. A bare 1.75dp outline would
     be the one tile that is not that - a small grey line drawing among
     pictures - so this one is drawn like the icons it sits between: a filled
     sheet in the app's own blue, with the folder mark in the middle of it.

     The sheet is the whole 24 units on purpose. Clipping happens outside this
     file, so anything drawn short of the edges would show the board through a
     rounded corner; the mark is the part that is inset, and by a fraction
     rather than a fixed dp so it keeps its share of an icon that is a setting
     (48dp or 96dp, see Prefs.iconSize). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="@color/hub_blue_600"
        android:pathData="M0,0 L24,0 L24,24 L0,24 Z" />
    <group
        android:pivotX="12"
        android:pivotY="12"
        android:scaleX="0.62"
        android:scaleY="0.62">
        <path
            android:fillColor="#00000000"
            android:pathData="M3,8.4 A1.7,1.7 0 0 1 4.7,6.7 L9.2,6.7 A1.7,1.7 0 0 1 10.4,7.3 L11.5,8.8 L19.3,8.8 A1.7,1.7 0 0 1 21,10.5 L21,17.3 A1.7,1.7 0 0 1 19.3,19 L4.7,19 A1.7,1.7 0 0 1 3,17.3 Z"
            android:strokeColor="#FFFFFF"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:strokeWidth="2.6" />
    </group>
</vector>
